rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@isolutionsico.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*')) ||
        request.auth.token.admin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSignedIn();
    }

    // --- USER PROFILES COLLECTION ---
    match /user_profiles/{userId} {
      allow read, write: if isOwner(userId) || isSignedIn();
    }

    // --- PROJECTS COLLECTION ---
    match /projects/{projectId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || !('userId' in resource.data));
    }

    // --- SCANS COLLECTION ---
    match /scans/{scanId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || !('userId' in resource.data));
    }

    // --- REFERRAL CLICKS COLLECTION ---
    match /referralClicks/{clickId} {
      allow create: if true;
      allow read, write: if isSignedIn();
    }

    // --- NOTIFICATIONS COLLECTION ---
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // --- COMMUNITY POSTS COLLECTION ---
    match /communityPosts/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- ROADMAP ITEMS COLLECTION ---
    match /roadmapItems/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- NEWSLETTER SUBSCRIBERS COLLECTION ---
    match /newsletterSubscribers/{subId} {
      allow create: if true;
      allow read, write: if isSignedIn();
    }

    // --- FEEDBACK COLLECTION ---
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, write: if isSignedIn();
    }
  }
}
