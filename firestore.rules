rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Global document rule for all collections and documents
    match /{document=**} {
      allow read, write: if true;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get, list, read, write, create, update, delete: if true;
    }

    // --- USER PROFILES COLLECTION ---
    match /user_profiles/{userId} {
      allow get, list, read, write, create, update, delete: if true;
    }

    // --- PROJECTS COLLECTION ---
    match /projects/{projectId} {
      allow get, list, read, write, create, update, delete: if true;
    }

    // --- SCANS COLLECTION ---
    match /scans/{scanId} {
      allow get, list, read, write, create, update, delete: if true;
    }

    // --- REFERRAL CLICKS COLLECTION ---
    match /referralClicks/{clickId} {
      allow get, list, read, write, create, update, delete: if true;
    }

    // --- NOTIFICATIONS COLLECTION ---
    match /notifications/{notificationId} {
      allow get, list, read, write, create, update, delete: if true;
    }

    // --- COMMUNITY POSTS COLLECTION ---
    match /communityPosts/{postId} {
      allow get, list, read, write, create, update, delete: if true;
    }

    // --- ROADMAP ITEMS COLLECTION ---
    match /roadmapItems/{itemId} {
      allow get, list, read, write, create, update, delete: if true;
    }

    // --- NEWSLETTER SUBSCRIBERS COLLECTION ---
    match /newsletterSubscribers/{subId} {
      allow get, list, read, write, create, update, delete: if true;
    }

    // --- FEEDBACK COLLECTION ---
    match /feedback/{feedbackId} {
      allow get, list, read, write, create, update, delete: if true;
    }
  }
}
