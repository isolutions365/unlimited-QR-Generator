{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with email and authentication hash",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "name", "passwordHash", "createdAt"]
    },
    "QRProject": {
      "title": "QRProject",
      "description": "QR Code Project customization parameters and statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["url", "text", "wifi", "card", "email", "phone", "sms", "social", "crypto", "geo"] },
        "content": { "type": "string" },
        "design": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "scanCount": { "type": "integer" },
        "trackingEnabled": { "type": "boolean" },
        "trackingId": { "type": "string" },
        "expiryDate": { "type": "string", "format": "date" },
        "expiryRedirectType": { "type": "string", "enum": ["message", "url"] },
        "expiryRedirectUrl": { "type": "string" },
        "expiryMessage": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "userId", "name", "type", "content", "design", "createdAt", "scanCount", "trackingEnabled", "trackingId"]
    },
    "ScanLog": {
      "title": "ScanLog",
      "description": "Analytics scan logging for tracked visits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "trackingId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "deviceType": { "type": "string" },
        "browser": { "type": "string" },
        "approxLocation": { "type": "string" },
        "ip": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "projectId", "trackingId", "timestamp", "deviceType", "browser", "approxLocation", "ip", "userId"]
    },
    "DynamicQR": {
      "title": "DynamicQR",
      "description": "Dynamic redirect QR with redirection rules, access protection, and campaign tags",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "destinationUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "paused", "expired", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiryAt": { "type": "string", "format": "date-time" },
        "password": { "type": "string" },
        "countryRules": { "type": "object" },
        "deviceRules": { "type": "object" },
        "timeRules": { "type": "object" },
        "campaign": { "type": "string" },
        "analytics": { "type": "object" }
      },
      "required": ["id", "ownerId", "destinationUrl", "status", "createdAt"]
    },
    "DynamicQRScanLog": {
      "title": "DynamicQRScanLog",
      "description": "Granular scan events for a specific Dynamic QR redirection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "qrId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "country": { "type": "string" },
        "ipHash": { "type": "string" },
        "referrer": { "type": "string" }
      },
      "required": ["id", "qrId", "timestamp", "device", "browser", "country"]
    },
    "CustomForm": {
      "title": "CustomForm",
      "description": "User-designed custom forms linked to QR codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["contact", "survey", "lead", "registration", "appointment", "rsvp", "feedback"] },
        "fields": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "viewCount": { "type": "integer" },
        "submissionCount": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "themeColor": { "type": "string", "enum": ["indigo", "emerald", "rose", "amber", "purple", "cyan"] }
      },
      "required": ["id", "userId", "title", "type", "fields", "createdAt"]
    },
    "FormSubmission": {
      "title": "FormSubmission",
      "description": "Form submissions by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "formId": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "answers": { "type": "object" },
        "attachments": { "type": "array" }
      },
      "required": ["id", "formId", "submittedAt", "answers"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Collection of signed up users"
    },
    "projects/{projectId}": {
      "schema": "QRProject",
      "description": "Collection of QR key objects"
    },
    "scans/{scanId}": {
      "schema": "ScanLog",
      "description": "Global log of scanned click interactions"
    },
    "dynamicQRs/{qrId}": {
      "schema": "DynamicQR",
      "description": "Redirection and dynamic rule configuration for QR codes"
    },
    "dynamicQRs/{qrId}/scans/{scanId}": {
      "schema": "DynamicQRScanLog",
      "description": "Granular telemetry logs for specific dynamic redirects"
    },
    "custom_forms/{formId}": {
      "schema": "CustomForm",
      "description": "Forms created by QR-code owners"
    },
    "custom_forms/{formId}/submissions/{submissionId}": {
      "schema": "FormSubmission",
      "description": "Submissions for a custom form"
    },
    "submissions/{submissionId}": {
      "schema": "FormSubmission",
      "description": "Top-level submissions for landing pages"
    }
  }
}
